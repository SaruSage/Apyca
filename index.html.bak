<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cadeira A3 — Simulador Estrutural</title>
<style>
  :root{
    --fundo:#12161c; --painel:#1a2029; --borda:#2a3341; --texto:#e7edf5;
    --fraco:#8b9aad; --acento:#4fa3ff; --ok:#3ecf8e; --erro:#f2555a;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--fundo);color:var(--texto);
    font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
  .topo{padding:24px 32px 8px}
  .topo h1{margin:0;font-size:1.6rem;letter-spacing:-.02em}
  .sub{margin:4px 0 0;color:var(--fraco);font-size:.9rem}
  .layout{display:grid;grid-template-columns:280px 1fr 340px;gap:16px;
    padding:16px 32px 40px;align-items:start}
  @media(max-width:1100px){.layout{grid-template-columns:1fr}}
  .painel{background:var(--painel);border:1px solid var(--borda);border-radius:12px;padding:20px}
  .painel h2{margin:0 0 16px;font-size:.78rem;text-transform:uppercase;
    letter-spacing:.09em;color:var(--fraco);font-weight:600}
  .campo{margin-bottom:14px}
  .campo label{display:block;font-size:.82rem;color:var(--fraco);margin-bottom:5px}
  .campo input,.campo select{width:100%;padding:9px 11px;background:#11161d;
    border:1px solid var(--borda);border-radius:7px;color:var(--texto);
    font-size:.95rem;font-family:inherit}
  .campo input:focus,.campo select:focus{outline:none;border-color:var(--acento)}
  .botao{width:100%;padding:11px;margin-top:6px;background:var(--acento);
    color:#08121f;border:none;border-radius:8px;font-size:.95rem;
    font-weight:650;cursor:pointer;font-family:inherit}
  .palco{min-height:440px;display:flex;flex-direction:column;align-items:center;
    justify-content:center;background:#0e1218;border-radius:8px}
  .legenda{width:100%;margin:10px 0 0;text-align:center;font-size:.8rem;
    color:var(--fraco);font-variant-numeric:tabular-nums}
  .linha{display:flex;justify-content:space-between;gap:12px;padding:7px 0;
    border-bottom:1px solid rgba(42,51,65,.6);font-size:.88rem}
  .linha:last-child{border-bottom:none}
  .rotulo{color:var(--fraco)}
  .valor{font-variant-numeric:tabular-nums;font-weight:600}
  .grupo{margin-bottom:18px}
  .grupo h3{margin:0 0 6px;font-size:.75rem;text-transform:uppercase;
    letter-spacing:.07em;color:var(--acento);font-weight:600}
  .veredito{margin-top:16px;padding:12px 14px;border-radius:8px;font-size:.88rem;font-weight:600}
  .veredito--ok{background:rgba(62,207,142,.12);border:1px solid rgba(62,207,142,.4);color:var(--ok)}
  .veredito--erro{background:rgba(242,85,90,.12);border:1px solid rgba(242,85,90,.4);color:var(--erro)}
  .veredito ul{margin:8px 0 0;padding-left:18px;font-weight:400}
  #erro-global{display:none;margin:0 32px 16px;padding:14px 16px;border-radius:8px;
    background:rgba(242,85,90,.14);border:1px solid rgba(242,85,90,.5);
    color:#ffd7d8;font-family:ui-monospace,monospace;font-size:.82rem;white-space:pre-wrap}
</style>
</head>
<body>

<header class="topo">
  <h1>Cadeira A3</h1>
  <p class="sub">Simulador de dimensionamento estrutural</p>
</header>

<div id="erro-global"></div>

<main class="layout">
  <section class="painel">
    <h2>Entradas</h2>
    <form id="form">
      <div class="campo">
        <label for="material">Material</label>
        <select id="material"></select>
      </div>
      <div class="campo">
        <label for="espessura">Espessura da perna (cm)</label>
        <input id="espessura" type="number" min="0.5" max="15" step="0.5" value="4">
      </div>
      <div class="campo">
        <label for="altura">Altura da perna (cm)</label>
        <input id="altura" type="number" min="20" max="120" step="1" value="45">
      </div>
      <div class="campo">
        <label for="massa">Massa do usuário (kg)</label>
        <input id="massa" type="number" min="10" max="250" step="1" value="90">
      </div>
            <div class="campo">
        <label for="forma">Formato da perna</label>
        <select id="forma">
          <option value="quadrada">Quadrada</option>
          <option value="redonda">Redonda</option>
        </select>
      </div>
      <div class="campo">
        <label for="numPernas">Número de pernas</label>
        <select id="numPernas">
          <option value="4">4 pernas</option>
          <option value="1">1 perna (pedestal)</option>
        </select>
      </div>
      <button type="submit" class="botao">Simular</button>
    </form>
  </section>

  <section class="painel">
    <h2>Vista isométrica</h2>
    <div id="palco" class="palco"></div>
  </section>

  <section class="painel">
    <h2>Resultados</h2>
    <div id="resultado"></div>
  </section>
</main>

<script>
/* Painel de erro visivel: substitui o console */
(function(){
  var box = document.getElementById('erro-global');
  function show(msg){
    box.style.display = 'block';
    box.textContent += msg + '\n';
  }
  window.addEventListener('error', function(e){
    show('ERRO: ' + (e.message || 'falha de carregamento') +
         (e.filename ? '\n  em ' + e.filename + ':' + e.lineno : ''));
  }, true);
  window.addEventListener('unhandledrejection', function(e){
    show('PROMISE: ' + (e.reason && e.reason.message ? e.reason.message : e.reason));
  });
})();

/* ============================ CONSTANTES ============================ */
var G = 9.81;

var HIPOTESES = { nPernas:4, L:400, e:50, K:1.0, mAssento:2.0 };

var CADEIRA = {
  L:400,
  folga:20,
  fracaoEspessuraAssento:0.5,
  fracaoEspessuraEncosto:0.5,
  alturaAbertura:90,
  alturaEncosto:320,
  espessuraMaxima:150,
  fracaoApoioEncosto:0.5
};

/* ============================= MATERIAIS ============================ */
var CORES = { cinzaEscuro:'#4a4f55', vinhoEscuro:'#5c1f2b' };

var MATERIAIS = {
  madeira: {
    id:'madeira', nome:'Madeira estrutural (C-40)',
    E:9500, sigmaLimite:40, rho:600, CS:2.0, cor:'#a9713f',
    render:{ pernas:'#a9713f', assento:'#a9713f',
             encosto:{tipo:'painel', cor:'#a9713f'}, veios:true }
  },
  aco: {
    id:'aco', nome:'Aco ASTM A36',
    E:200000, sigmaLimite:250, rho:7850, CS:1.5, cor:'#8a9099',
    render:{ pernas:'#8a9099', assento:CORES.cinzaEscuro,
             encosto:{tipo:'ripas', cor:'#8a9099', n:3, fracao:0.2}, veios:false }
  },
  aluminio: {
    id:'aluminio', nome:'Aluminio 6061-T6',
    E:69000, sigmaLimite:240, rho:2700, CS:1.5, cor:'#c3c9cf',
    render:{ pernas:'#c3c9cf', assento:CORES.cinzaEscuro,
             encosto:{tipo:'painel', cor:CORES.vinhoEscuro}, veios:false }
  }
};

/* ============================= GEOMETRIA ============================ */
function propriedadesSecao(t, forma){
  var c = t/2;
  var A, I;
  if(forma === 'redonda'){
    A = Math.PI*t*t/4;
    I = Math.PI*Math.pow(t,4)/64;
  } else {
    A = t*t;
    I = Math.pow(t,4)/12;
  }
  return { A:A, I:I, c:c, W:I/c, r:Math.sqrt(I/A) };
}

/* ============================== SOLVER ============================== */
function calcular(inp){
  var erros = [];
  if(!(inp.espessuraMm>0)) erros.push('A espessura deve ser maior que zero.');
  if(!(inp.alturaMm>0)) erros.push('A altura deve ser maior que zero.');
  if(!(inp.massaKg>0)) erros.push('A massa deve ser maior que zero.');
  var material = MATERIAIS[inp.materialId];
  if(!material) erros.push('Material desconhecido.');
  if(erros.length) return { ok:false, erros:erros };

  var forma = (inp.forma === 'redonda') ? 'redonda' : 'quadrada';
  var n = (inp.numPernas === 1) ? 1 : 4;

  var t = inp.espessuraMm, H = inp.alturaMm, m = inp.massaKg;
  var L = HIPOTESES.L, e = HIPOTESES.e, K = HIPOTESES.K;

  var sec = propriedadesSecao(t, forma);
  var A = sec.A, I = sec.I, c = sec.c, W = sec.W;

  var P = m*G;
  var Nmedio, dN, Nmax, Mperna, levantou = false;

  if(n === 1){
    Nmedio = P;
    dN = 0;
    Nmax = P;
    Mperna = P*e;
  } else {
    Nmedio = P/n;
    dN = (P*e)/(2*L);
    Nmax = Nmedio + dN;
    Mperna = (P*e)/n;
    levantou = dN > Nmedio;
  }
  var Nmin = Math.max(0, Nmedio - dN);

  var sigmaAxial = Nmax/A;
  var sigmaFlexao = Mperna/W;
  var sigmaMax = sigmaAxial + sigmaFlexao;
  var sigmaAdm = material.sigmaLimite/material.CS;
  var utilizacao = sigmaMax/sigmaAdm;

  var lambda = (K*H)/sec.r;
  var Pcr = (Math.PI*Math.PI*material.E*I)/Math.pow(K*H,2);
  var NcrAdm = Pcr/material.CS;
  var utFlamb = Nmax/NcrAdm;

  var delta = (Nmax*H)/(A*material.E);

  var volPernas = (n*A*H)/1e9;
  var massaPernas = volPernas*material.rho;
  var massaTotal = massaPernas + HIPOTESES.mAssento;

  var motivos = [];
  if(utilizacao>1) motivos.push('Tensao '+fmt(sigmaMax)+' MPa acima da admissivel '+fmt(sigmaAdm)+' MPa.');
  if(utFlamb>1) motivos.push('Flambagem: '+fmt(Nmax)+' N acima de '+fmt(NcrAdm)+' N.');
  if(levantou) motivos.push('A excentricidade levanta as pernas do lado oposto.');

  return {
    ok:true,
    entrada:{ material:material, t:t, H:H, m:m, forma:forma, numPernas:n },
    secao:{ A:A, I:I, W:W, c:c, r:sec.r, lambda:lambda },
    forcas:{ P:P, Nmedio:Nmedio, dN:dN, Nmax:Nmax, Nmin:Nmin, Mperna:Mperna },
    tensoes:{ sigmaAxial:sigmaAxial, sigmaFlexao:sigmaFlexao, sigmaMax:sigmaMax,
              sigmaAdm:sigmaAdm, utilizacao:utilizacao },
    flambagem:{ lambda:lambda, Pcr:Pcr, NcrAdm:NcrAdm, utilizacao:utFlamb },
    deformacao:{ delta:delta },
    massa:{ pernas:massaPernas, total:massaTotal },
    veredito:{ aprovado: motivos.length===0, motivos:motivos }
  };
}

function fmt(v){
  return v.toLocaleString('pt-BR',{maximumFractionDigits:2});
}

/* =========================== MODELO 3D ============================== */
function caixa(x,y,z,dx,dy,dz,camada,cor){
  return {tipo:'caixa', x:x,y:y,z:z,dx:dx,dy:dy,dz:dz,camada:camada,cor:cor};
}
function cilindro(cx,cy,r,z0,h,camada,cor){
  return {tipo:'cilindro', cx:cx,cy:cy,r:r,z0:z0,h:h,camada:camada,cor:cor};
}
function bboxPeca(p){
  if(p.tipo === 'cilindro'){
    return { min:[p.cx-p.r, p.cy-p.r, p.z0], max:[p.cx+p.r, p.cy+p.r, p.z0+p.h] };
  }
  return { min:[p.x,p.y,p.z], max:[p.x+p.dx,p.y+p.dy,p.z+p.dz] };
}

function encostoRipas(x0, y0, larg, zBase, alt, prof, cor, n, fracao){
  var unidade = alt/(2*n-1);
  var pRipa = fracao*prof;
  var out = [];
  for(var i=0;i<n;i++){
    out.push(caixa(x0, y0, zBase+i*2*unidade, larg, pRipa, unidade, 3, cor));
  }
  return out;
}

function construirBarras(espessura, altura, material, forma, numPernas){
  var L = CADEIRA.L, folga = CADEIRA.folga;
  var render = (material && material.render) || MATERIAIS.madeira.render;
  var redonda = (forma === 'redonda');
  var n = (numPernas === 1) ? 1 : 4;

  var t = Math.min(espessura, CADEIRA.espessuraMaxima);
  var H = altura;

  var tAssento = CADEIRA.fracaoEspessuraAssento*t;
  var tEnc = CADEIRA.fracaoEspessuraEncosto*t;

  var zTopoAssento = H + tAssento;
  var zTopoEncosto = zTopoAssento + CADEIRA.alturaEncosto;
  var zBaseEncosto = zTopoAssento + CADEIRA.alturaAbertura;

  var b = [];

  function perna(x, y, z0, h, camada){
    if(redonda){
      b.push(cilindro(x + t/2, y + t/2, t/2, z0, h, camada, render.pernas));
    } else {
      b.push(caixa(x, y, z0, t, t, h, camada, render.pernas));
    }
  }

  if(n === 4){
    perna(0,     L-t, 0, H, 0);
    perna(L-t,   L-t, 0, H, 0);
    perna(0,     0,   0, H, 0);
    perna(L-t,   0,   0, H, 0);
  } else {
    perna(L/2-t/2, L/2-t/2, 0, H, 0);
  }

  b.push(caixa(-folga, -folga, H, L+2*folga, L+2*folga, tAssento, 2, render.assento));

  var altPainel = zTopoEncosto - zBaseEncosto;
  var zTopoPoste = zBaseEncosto + altPainel*CADEIRA.fracaoApoioEncosto;
  var hPoste = zTopoPoste - zTopoAssento;

  if(n === 4){
    perna(0,   0, zTopoAssento, hPoste, 3);
    perna(L-t, 0, zTopoAssento, hPoste, 3);
  } else {
    perna(L/2-t/2, L/2-t/2, zTopoAssento, hPoste, 3);
  }

  var largPainel = L - 2*t;
  var spec = render.encosto || { tipo:'painel', cor:render.pernas };
  var corEnc = spec.cor || render.pernas;
  var yPainel = (n === 1) ? (L/2 - t/2) : 0;

  if(altPainel>0 && largPainel>0){
    if(spec.tipo === 'ripas'){
      var ripas = encostoRipas(t, yPainel, largPainel, zBaseEncosto, altPainel,
                               tEnc, corEnc, spec.n||3, spec.fracao||0.2);
      for(var k=0;k<ripas.length;k++) b.push(ripas[k]);
    } else {
      b.push(caixa(t, yPainel, zBaseEncosto, largPainel, tEnc, altPainel, 3, corEnc));
    }
  }

  return b;
}

function dimensoesExternas(barras){
  var min=[Infinity,Infinity,Infinity], max=[-Infinity,-Infinity,-Infinity];
  for(var i=0;i<barras.length;i++){
    var bb = bboxPeca(barras[i]);
    for(var a=0;a<3;a++){
      if(bb.min[a]<min[a]) min[a]=bb.min[a];
      if(bb.max[a]>max[a]) max[a]=bb.max[a];
    }
  }
  return { largura:max[0]-min[0], profundidade:max[1]-min[1], altura:max[2]-min[2] };
}

/* ========================== PROJECAO ISO ============================ */
var COS30 = Math.cos(Math.PI/6);
var SOMBRA = { top:1.16, front:0.94, side:0.70 };

function project(p, escala, origem){
  return [
    origem[0] + (p[0]-p[1])*COS30*escala,
    origem[1] + ((p[0]+p[1])*0.5 - p[2])*escala
  ];
}

function facesDaCaixa(p){
  var X = p.x+p.dx, Y = p.y+p.dy, Z = p.z+p.dz;
  return [
    { kind:'top',   quad:[[p.x,p.y,Z],[X,p.y,Z],[X,Y,Z],[p.x,Y,Z]] },
    { kind:'front', quad:[[p.x,Y,p.z],[X,Y,p.z],[X,Y,Z],[p.x,Y,Z]] },
    { kind:'side',  quad:[[X,p.y,p.z],[X,Y,p.z],[X,Y,Z],[X,p.y,Z]] }
  ];
}

function computeView(barras, largura, altura, margem){
  var min = [Infinity,Infinity,Infinity];
  var max = [-Infinity,-Infinity,-Infinity];
  for(var i=0;i<barras.length;i++){
    var bb = bboxPeca(barras[i]);
    for(var a=0;a<3;a++){
      if(bb.min[a]<min[a]) min[a]=bb.min[a];
      if(bb.max[a]>max[a]) max[a]=bb.max[a];
    }
  }
  var cantos = [];
  var xs0=[min[0],max[0]], ys0=[min[1],max[1]], zs0=[min[2],max[2]];
  for(var i2=0;i2<2;i2++) for(var j2=0;j2<2;j2++) for(var k2=0;k2<2;k2++){
    cantos.push(project([xs0[i2],ys0[j2],zs0[k2]],1,[0,0]));
  }
  var px = cantos.map(function(c){return c[0];});
  var py = cantos.map(function(c){return c[1];});
  var lw = Math.max.apply(null,px)-Math.min.apply(null,px);
  var lh = Math.max.apply(null,py)-Math.min.apply(null,py);

  var utilL = largura-2*margem, utilA = altura-2*margem;
  var escala = Math.min(utilL/lw, utilA/lh);
  var origem = [
    margem + (utilL-lw*escala)/2 - Math.min.apply(null,px)*escala,
    margem + (utilA-lh*escala)/2 - Math.min.apply(null,py)*escala
  ];
  return { escala:escala, origem:origem, bounds:{min:min,max:max} };
}

function sombrear(hex,k){
  var s = hex.replace('#','');
  if(s.length===3) s = s[0]+s[0]+s[1]+s[1]+s[2]+s[2];
  var n = parseInt(s,16);
  var r = (n>>16)&255, g = (n>>8)&255, bl = n&255;
  return 'rgb(' + [r,g,bl].map(function(v){
    return Math.max(0,Math.min(255,Math.round(v*k)));
  }).join(',') + ')';
}

var LADOS_CILINDRO = 12;

function facesDoCilindro(p, lados){
  var out = [];
  var z0 = p.z0, z1 = p.z0 + p.h;
  for(var i=0;i<lados;i++){
    var a0 = 2*Math.PI*i/lados;
    var a1 = 2*Math.PI*(i+1)/lados;
    var am = (a0+a1)/2;
    var nx = Math.cos(am), ny = Math.sin(am);
    if(nx + ny <= 0.01) continue;
    var x0 = p.cx + p.r*Math.cos(a0), y0 = p.cy + p.r*Math.sin(a0);
    var x1 = p.cx + p.r*Math.cos(a1), y1 = p.cy + p.r*Math.sin(a1);
    out.push({
      kind:'side',
      luz:0.70 + 0.26*((nx+ny)/Math.SQRT2),
      quad:[[x0,y0,z0],[x1,y1,z0],[x1,y1,z1],[x0,y0,z1]]
    });
  }
  var topo = [];
  for(var j=0;j<lados;j++){
    var a = 2*Math.PI*j/lados;
    topo.push([p.cx + p.r*Math.cos(a), p.cy + p.r*Math.sin(a), z1]);
  }
  out.push({ kind:'top', luz:1.16, quad:topo });
  return out;
}

function buildFaces(barras, escala, origem, corBase){
  var faces = [];
  for(var i=0;i<barras.length;i++){
    var p = barras[i];
    var bb = bboxPeca(p);
    var prof = bb.max[0] + bb.max[1] + bb.max[2];
    var cor = p.cor || corBase;
    var fs = (p.tipo === 'cilindro')
      ? facesDoCilindro(p, LADOS_CILINDRO)
      : facesDaCaixa(p);
    for(var j=0;j<fs.length;j++){
      var f = fs[j];
      var k = (f.luz !== undefined) ? f.luz : SOMBRA[f.kind];
      faces.push({
        kind:f.kind,
        tela:f.quad.map(function(pt){ return project(pt,escala,origem); }),
        camada:p.camada || 0,
        prof:prof,
        barras:p,
        tipo:p.tipo || 'caixa',
        fill:sombrear(cor,k),
        contorno:sombrear(cor,k*0.72)
      });
    }
  }
  faces.sort(function(a,b){ return (a.camada-b.camada) || (a.prof-b.prof); });
  return faces;
}

/* ============================= RENDER =============================== */
var LARGURA_SVG = 860, ALTURA_SVG = 620;

function poly(pts){
  return pts.map(function(p){ return p[0].toFixed(1)+','+p[1].toFixed(1); }).join(' ');
}

function veios(b, escala, origem){
  var menor = Math.min(b.dx,b.dy);
  var n = Math.min(7, Math.max(2, Math.round(menor/14)));
  var z = b.z + b.dz;
  var out = '';
  for(var i=1;i<=n;i++){
    var k = i/(n+1);
    var y = b.y + b.dy*k;
    var a = project([b.x,y,z],escala,origem);
    var c = project([b.x+b.dx,y,z],escala,origem);
    var op = 0.08 + 0.05*((i*37)%5)/4;
    out += '<line x1="'+a[0].toFixed(1)+'" y1="'+a[1].toFixed(1)+'" '+
           'x2="'+c[0].toFixed(1)+'" y2="'+c[1].toFixed(1)+'" '+
           'stroke="#000" stroke-opacity="'+op.toFixed(3)+'" '+
           'stroke-width="1.1" stroke-linecap="round"/>';
  }
  return out;
}

function renderCadeira(container, barras, material){
  var view = computeView(barras, LARGURA_SVG, ALTURA_SVG, 48);
  var faces = buildFaces(barras, view.escala, view.origem, material.cor);
  var mostrarVeios = material.render && material.render.veios === true;
  var conteudo = [];

  var bd = view.bounds;
  var m = 0.16*(bd.max[0]-bd.min[0]);
  var sombra = [
    [bd.min[0]-m, bd.min[1]-m, 0],
    [bd.max[0]+m, bd.min[1]-m, 0],
    [bd.max[0]+m, bd.max[1]+m, 0],
    [bd.min[0]-m, bd.max[1]+m, 0]
  ].map(function(c){ return project(c, view.escala, view.origem); });

  conteudo.push('<polygon points="'+poly(sombra)+'" fill="#000" fill-opacity="0.5" filter="url(#borrao)"/>');

  for(var i=0;i<faces.length;i++){
    var f = faces[i];
    conteudo.push('<polygon points="'+poly(f.tela)+'" fill="'+f.fill+'" '+
      'stroke="'+f.contorno+'" stroke-width="0.9" stroke-linejoin="round"/>');
      if(mostrarVeios && f.kind === 'top' && f.tipo !== 'cilindro'){
      conteudo.push(veios(f.barras, view.escala, view.origem));
    }
  }

  container.innerHTML =
    '<svg viewBox="0 0 '+LARGURA_SVG+' '+ALTURA_SVG+'" width="100%" role="img" '+
    'aria-label="Vista isometrica da cadeira">'+
      '<defs><filter id="borrao" x="-40%" y="-40%" width="180%" height="180%">'+
      '<feGaussianBlur stdDeviation="12"/></filter></defs>'+
      conteudo.join('')+
    '</svg>';

  return {
    largura: bd.max[0]-bd.min[0],
    profundidade: bd.max[1]-bd.min[1],
    altura: bd.max[2]-bd.min[2]
  };
}

/* =============================== APP ================================ */
(function(){
  var form = document.getElementById('form');
  var sel = document.getElementById('material');
  var inEsp = document.getElementById('espessura');
  var inAlt = document.getElementById('altura');
  var inMas = document.getElementById('massa');
  var inForma = document.getElementById('forma');
  var inPernas = document.getElementById('numPernas');
  var painel = document.getElementById('resultado');
  var palco = document.getElementById('palco');

  Object.keys(MATERIAIS).forEach(function(id){
    var o = document.createElement('option');
    o.value = id;
    o.textContent = MATERIAIS[id].nome;
    sel.appendChild(o);
  });

  function num(v,casas){
    return v.toLocaleString('pt-BR',{
      minimumFractionDigits:casas, maximumFractionDigits:casas
    });
  }
  function linha(rot,val){
    return '<div class="linha"><span class="rotulo">'+rot+'</span>'+
           '<span class="valor">'+val+'</span></div>';
  }
  function grupo(tit,linhas){
    return '<div class="grupo"><h3>'+tit+'</h3>'+linhas.join('')+'</div>';
  }

  function renderResultado(r){
    if(!r.ok){
      painel.innerHTML = '<div class="veredito veredito--erro">'+r.erros.join(' ')+'</div>';
      return;
    }
    var h = '';
        h += grupo('Secao e apoios',[
      linha('Formato da perna', r.entrada.forma === 'redonda' ? 'Redonda' : 'Quadrada'),
      linha('Numero de pernas', r.entrada.numPernas === 1 ? '1 (pedestal central)' : '4'),
      linha('Area (A)', num(r.secao.A,0)+' mm²'),
      linha('Inercia (I)', num(r.secao.I,0)+' mm⁴'),
      linha('Modulo resistente (W)', num(r.secao.W,0)+' mm³'),
      linha('Raio de giracao (r)', num(r.secao.r,3)+' mm')
    ]);
    h += grupo('Esforcos',[
      linha('Carga total (P)', num(r.forcas.P,1)+' N'),
      linha('Reacao media por perna', num(r.forcas.Nmedio,1)+' N'),
      linha('Reacao maxima (N)', num(r.forcas.Nmax,1)+' N'),
      linha('Momento na perna (M)', num(r.forcas.Mperna,0)+' N·mm')
    ]);
    h += grupo('Tensoes normais',[
      linha('Axial (N/A)', num(r.tensoes.sigmaAxial,3)+' MPa'),
      linha('Flexao (M·c/I)', num(r.tensoes.sigmaFlexao,3)+' MPa'),
      linha('Maxima', num(r.tensoes.sigmaMax,3)+' MPa'),
      linha('Admissivel', num(r.tensoes.sigmaAdm,3)+' MPa'),
      linha('Utilizacao', num(r.tensoes.utilizacao*100,1)+'%')
    ]);
    h += grupo('Flambagem',[
      linha('Indice de esbeltez', num(r.flambagem.lambda,1)),
      linha('Carga critica (Pcr)', num(r.flambagem.Pcr/1000,2)+' kN'),
      linha('Utilizacao', num(r.flambagem.utilizacao*100,1)+'%')
    ]);
    h += grupo('Deformacao e massa',[
      linha('Encurtamento axial', num(r.deformacao.delta,4)+' mm'),
      linha('Massa das pernas', num(r.massa.pernas,2)+' kg'),
      linha('Massa total', num(r.massa.total,2)+' kg')
    ]);
    if(r.veredito.aprovado){
      h += '<div class="veredito veredito--ok">Configuracao aprovada em todos os criterios.</div>';
    } else {
      h += '<div class="veredito veredito--erro">Configuracao reprovada.<ul>'+
           r.veredito.motivos.map(function(mt){ return '<li>'+mt+'</li>'; }).join('')+
           '</ul></div>';
    }
    painel.innerHTML = h;
  }

    function simular(){
    var tMm = parseFloat(inEsp.value)*10;
    var hMm = parseFloat(inAlt.value)*10;
    var mMassa = parseFloat(inMas.value);

    var r = calcular({
      materialId: sel.value,
      espessuraMm: tMm,
      alturaMm: hMm,
      massaKg: mMassa,
      forma: inForma.value,
      numPernas: parseInt(inPernas.value, 10)
    });
    renderResultado(r);
    if(!r.ok) return r;

    var material = r.entrada.material;
    var barras = construirBarras(r.entrada.t, r.entrada.H, material,
                                 r.entrada.forma, r.entrada.numPernas);
    var dims = renderCadeira(palco, barras, material);

    var p = document.createElement('p');
    p.className = 'legenda';
    p.textContent = num(dims.altura/10,1)+' × '+num(dims.largura/10,1)+' × '+
                    num(dims.profundidade/10,1)+' cm · material: '+material.nome;
    palco.appendChild(p);

    return r;
  }

  form.addEventListener('submit', function(ev){
    ev.preventDefault();
    simular();
  });
  form.addEventListener('input', simular);

  simular();
})();
</script>
</body>
</html>